---
import type { GetStaticPaths, Page } from 'astro'
import { getCollection, type CollectionEntry } from 'astro:content'
import { getUniqueTagsWithCount } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostList from '@/components/blog/PostList.astro'
import CategoryNav from '@/components/blog/CategoryNav.astro'
import CollectionList from '@/components/collections/CollectionList.astro'
import { site } from '@/site-config'

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft && !data.language.toLowerCase().startsWith('zh'))).sort(
    (first, second) => second.data.publishDate.valueOf() - first.data.publishDate.valueOf()
  )
  return paginate(posts, { pageSize: 8, props: { tags: getUniqueTagsWithCount(posts) } })
}) satisfies GetStaticPaths

interface Props { page: Page<CollectionEntry<'blog'>>; tags: [string, number][] }
const { page, tags } = Astro.props
const collections = await getCollection('collections')
const meta = {
  title: page.currentPage === 1 ? 'All posts' : `All posts · Page ${page.currentPage}`,
  description: 'Every research note, technical essay, and learning log in the notebook.'
}
---

<PageLayout {meta}>
  <main class='page-column all-page'>
    <header class='all-heading'><p class='eyebrow'>Notebook / all posts</p><h1>All</h1><p>{meta.description}</p></header>
    <CategoryNav active='all' />
    <div class='list-summary'><span>Page {page.currentPage} · Showing {page.data.length} of {page.total} posts</span><a href='/archives'>View all posts by years →</a></div>
    <PostList posts={page.data} />
    {page.lastPage > 1 && <nav class='pagination' aria-label='Pagination'>{page.url.prev ? <a href={page.url.prev}>← Newer</a> : <span></span>}<span>{page.currentPage} / {page.lastPage}</span>{page.url.next ? <a href={page.url.next}>Older →</a> : <span></span>}</nav>}
    <section class='index-section'>
      <div class='section-heading'><div><p class='eyebrow'>Notebook / long threads</p><h2>Collections</h2></div><a href='/collections'>View all →</a></div>
      <p>{site.collectionsIntro}</p><CollectionList {collections} limit={3} />
    </section>
    <section class='index-section'>
      <div class='section-heading'><div><p class='eyebrow'>Notebook / subjects</p><h2>Tags</h2></div><a href='/tags'>Tag index →</a></div>
      <ul class='tag-list'>{tags.map(([tag, count]) => <li><a href={`/tags/${encodeURIComponent(tag)}`}>{tag}<small>{count}</small></a></li>)}</ul>
    </section>
  </main>
</PageLayout>

<style>
  .all-page { padding-top: 4.5rem; }
  .all-heading { max-width: 44rem; margin-bottom: 2rem; }
  .all-heading h1 { margin: 0.7rem 0 1rem; font: 500 clamp(3rem, 7vw, 5.4rem)/1 Georgia, 'Times New Roman', serif; letter-spacing: -0.06em; }
  .all-heading p:last-child { max-width: 38rem; margin: 0; color: hsl(var(--muted-foreground)); font-size: 0.96rem; line-height: 1.75; }
  .list-summary { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; color: hsl(var(--muted-foreground)); font: 0.72rem ui-monospace, monospace; }
  .list-summary a { color: hsl(var(--primary)); }
  .index-section { margin-top: 4.5rem; padding-top: 1.5rem; border-top: 1px solid var(--rule); }
  .section-heading { display: flex; align-items: end; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; }
  .section-heading h2 { margin: 0.55rem 0 0; font-size: 1.35rem; font-weight: 500; }
  .section-heading a { color: hsl(var(--muted-foreground)); font-size: 0.78rem; }
  .index-section > p { max-width: 38rem; margin: 0 0 1.5rem; color: hsl(var(--muted-foreground)); font-size: 0.9rem; line-height: 1.7; }
  .tag-list { display: flex; flex-wrap: wrap; gap: 0.8rem 1.5rem; list-style: none; padding: 0; }
  .tag-list a { font-size: 0.82rem; border-bottom: 1px solid var(--rule); padding-bottom: 0.2rem; }
  .tag-list small { margin-left: 0.5rem; color: hsl(var(--muted-foreground)); font: 0.66rem ui-monospace, monospace; }
  .pagination { display: flex; justify-content: space-between; margin-top: 2rem; font-size: 0.85rem; }
  @media (max-width: 640px) { .all-page { padding-top: 3rem; } .list-summary { flex-direction: column; gap: 0.5rem; } .index-section { margin-top: 3rem; } }
</style>
