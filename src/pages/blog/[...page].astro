---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { getUniqueTagsWithCount } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostList from '@/components/blog/PostList.astro'
import CategoryNav from '@/components/blog/CategoryNav.astro'
import { site } from '@/site-config'

export const prerender = true

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft && !data.language.toLowerCase().startsWith('zh'))).sort(
    (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
  )
  const tags = getUniqueTagsWithCount(posts).map(([tag]) => tag)
  return paginate(posts, { pageSize: 8, props: { tags, total: posts.length } })
}) satisfies GetStaticPaths

interface Props { page: Page<CollectionEntry<'blog'>>; tags: string[]; total: number }
const { page, tags, total } = Astro.props
const meta = { title: 'Blog', description: 'Research notes, technical writing, and learning in public.' }
---

<PageLayout {meta}>
  <main class='page-column blog-index'>
    <div class='blog-heading animate' id='content-header'>
      <p class='eyebrow'>Notebook / archive</p>
      <div class='flex items-end justify-between gap-4'><h1>All</h1><a class='archive-link' href='/archives'>View by year →</a></div>
      <p class='blog-intro'>A chronological record of questions I am trying to answer, tools I am trying to understand, and ideas worth keeping close.</p>
    </div>
    <CategoryNav />
    <div class='blog-grid'>
      <section class='animate' id='content' aria-label='Blog posts'>
        <div class='list-summary'><span>Page {page.currentPage} · Showing {page.data.length} of {total} posts</span><a href='/search'>Search the notebook ↗</a></div>
        {page.data.length > 0 ? <PostList posts={page.data} /> : <p>No posts yet.</p>}
        <div class='pagination'>{page.url.prev && <a href={page.url.prev}>← Newer</a>}{page.url.next && <a href={page.url.next}>Older →</a>}</div>
      </section>
      <aside class='tag-aside animate' id='sidebar'><p class='eyebrow'>Index</p><h2>Tags</h2><div class='tag-list'>{tags.slice(0, 18).map((tag) => <a href={`/tags/${tag}`}>{tag}</a>)}</div><a class='aside-more' href='/tags'>All tags →</a></aside>
    </div>
    <div class='blog-lower-grid'>
      <section class='lower-section'><div class='section-heading'><div><p class='eyebrow'>Long threads</p><h2>Collections</h2></div><a href='/collections'>View all →</a></div><p class='lower-copy'>{site.collectionsIntro}</p><a href='/collections' class='text-link'>Explore collections ↗</a></section>
      <section class='lower-section'><div class='section-heading'><div><p class='eyebrow'>Timeline</p><h2>Archives</h2></div><a href='/archives'>Open →</a></div><p class='lower-copy'>Find notes by the year they were written, with the shape of the archive left intact.</p><a href='/archives' class='text-link'>Browse years ↗</a></section>
    </div>
  </main>
</PageLayout>

<style>
  .blog-index { padding-top: 4.5rem; }
  .blog-heading { border-bottom: 1px solid var(--rule); padding-bottom: 2.5rem; }
  .blog-heading h1 { margin: 0.7rem 0 0; font: 500 clamp(3rem, 7vw, 5.4rem)/1 Georgia, 'Times New Roman', serif; letter-spacing: -0.06em; }
  .archive-link { color: hsl(var(--muted-foreground)); font-size: 0.8rem; }
  .blog-intro { max-width: 42rem; margin: 1.5rem 0 0; color: hsl(var(--muted-foreground)); font-size: 0.96rem; line-height: 1.75; }
  .blog-grid { display: grid; grid-template-columns: minmax(0, 1fr) 13rem; gap: 4rem; }
  .list-summary { display: flex; justify-content: space-between; gap: 1rem; margin-bottom: 1rem; color: hsl(var(--muted-foreground)); font: 0.72rem ui-monospace, SFMono-Regular, Menlo, monospace; }
  .list-summary a { color: hsl(var(--primary)); }
  .pagination { display: flex; justify-content: space-between; margin-top: 1.5rem; font-size: 0.82rem; }
  .tag-aside { padding-top: 2.65rem; }
  .tag-aside h2 { margin: 0.6rem 0 1rem; font-size: 1.1rem; font-weight: 500; }
  .tag-list { display: flex; flex-wrap: wrap; gap: 0.45rem 0.65rem; }
  .tag-list a { color: hsl(var(--muted-foreground)); font-size: 0.76rem; text-decoration: underline; text-decoration-color: hsl(var(--border)); text-underline-offset: 0.25rem; }
  .tag-list a:hover { color: hsl(var(--primary)); text-decoration-color: hsl(var(--primary)); }
  .aside-more, .text-link { display: inline-block; margin-top: 1.4rem; color: hsl(var(--primary)); font-size: 0.78rem; }
  .blog-lower-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 4rem; margin-top: 6rem; }
  .lower-section { border-top: 1px solid var(--rule); padding-top: 1rem; }
  .section-heading { display: flex; justify-content: space-between; gap: 1rem; align-items: end; }
  .section-heading h2 { margin: 0.55rem 0 0; font-size: 1.2rem; font-weight: 500; }
  .section-heading > a { color: hsl(var(--muted-foreground)); font-size: 0.75rem; }
  .lower-copy { margin: 1rem 0 0; color: hsl(var(--muted-foreground)); font-size: 0.84rem; line-height: 1.7; }
  @media (max-width: 800px) { .blog-grid { grid-template-columns: 1fr; gap: 3.5rem; } .tag-aside { padding-top: 0; } .blog-lower-grid { gap: 2rem; } }
  @media (max-width: 640px) { .blog-index { padding-top: 3rem; } .list-summary { flex-direction: column; gap: 0.5rem; } .blog-lower-grid { grid-template-columns: 1fr; margin-top: 4rem; } }
</style>
