---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'

import PageLayout from '@/layouts/BaseLayout.astro'
import CategoryNav from '@/components/blog/CategoryNav.astro'
import PostList from '@/components/blog/PostList.astro'
import { site } from '@/site-config'

export const prerender = true

export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection(
    'blog',
    ({ data }) => !data.draft && !data.language.toLowerCase().startsWith('zh')
  )
  const categories = site.blogCategories.filter(
    ({ slug }) => slug !== 'all' && slug !== 'paper-reading'
  )

  return categories.flatMap((category) => {
    const categoryPosts = posts
      .filter((post) => post.data.category === category.slug)
      .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())

    return paginate(categoryPosts, {
      pageSize: 8,
      params: { category: category.slug },
      props: { category }
    })
  })
}

interface Props {
  page: Page<CollectionEntry<'blog'>>
  category: (typeof site.blogCategories)[number]
}

const { page, category } = Astro.props
const meta = { title: category.label, description: category.description }
---

<PageLayout {meta}>
  <main class='page-column category-page'>
    <header class='category-heading'>
      <p class='eyebrow'>Notebook / category</p>
      <h1>{category.label}</h1>
      <p>{category.description}</p>
    </header>
    <CategoryNav active={category.slug} />
    <div class='category-summary'>
      <span>{page.data.length} notes on this page</span><a href='/blog/all'>All posts ↗</a>
    </div>
    {
      page.data.length > 0 ? (
        <PostList posts={page.data} />
      ) : (
        <p class='empty-state'>No notes in this category yet.</p>
      )
    }
    <div class='pagination'>
      {page.url.prev && <a href={page.url.prev}>← Newer</a>}{
        page.url.next && <a href={page.url.next}>Older →</a>
      }
    </div>
  </main>
</PageLayout>

<style>
  .category-page {
    padding-top: 4.5rem;
  }
  .category-heading {
    max-width: 44rem;
    margin-bottom: 2rem;
  }
  .category-heading h1 {
    margin: 0.7rem 0 1rem;
    font:
      500 clamp(3rem, 7vw, 5.4rem)/1 Georgia,
      'Times New Roman',
      serif;
    letter-spacing: -0.06em;
  }
  .category-heading p:last-child {
    max-width: 38rem;
    margin: 0;
    color: hsl(var(--muted-foreground));
    font-size: 0.96rem;
    line-height: 1.75;
  }
  .category-summary {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    color: hsl(var(--muted-foreground));
    font:
      0.72rem ui-monospace,
      SFMono-Regular,
      Menlo,
      monospace;
  }
  .category-summary a {
    color: hsl(var(--primary));
  }
  .empty-state {
    padding: 2rem 0;
    border-block: 1px solid var(--rule);
    color: hsl(var(--muted-foreground));
  }
  .pagination {
    display: flex;
    justify-content: space-between;
    margin-top: 1.5rem;
    font-size: 0.82rem;
  }
  @media (max-width: 640px) {
    .category-page {
      padding-top: 3rem;
    }
    .category-summary {
      flex-direction: column;
      gap: 0.5rem;
    }
  }
</style>
