---
import PageLayout from '@/layouts/BaseLayout.astro'
import { site } from '@/site-config'

const meta = { title: '关于', description: `关于 ${site.author} 与这本公开笔记。`, language: 'zh-CN' }
const principles = ['写作是为了暴露假设，而不是显得笃定。', '优先设计可以重复的小实验。', '在问题与证据之间留下清晰的路径。']
---

<PageLayout {meta}>
  <main class='page-column about-page'>
    <header class='about-heading'><p class='eyebrow'>关于 / 这本笔记</p><h1>为认真的工作<br /><em>留出空间。</em></h1><p>我是 Zeyan，一名研究者和工程师。这里记录我想要真正理解的想法。</p></header>
    <section class='about-section'><div><p class='eyebrow'>01 / 方法</p><h2>我如何使用这个网站</h2></div><div class='about-copy'><p>这是一本公开的工作笔记，而不是已经完成的作品集。我用它把问题变成解释，把实验变成记录，并保留值得再次找到的实现细节。</p><p>内容涉及强化学习、科学机器学习、研究工具，以及把困难概念理解清楚的慢工作。</p></div></section>
    <section class='about-section'><div><p class='eyebrow'>02 / 原则</p><h2>几条工作准则</h2></div><ol class='principles-list'>{principles.map((principle, index) => <li><span>0{index + 1}</span><p>{principle}</p></li>)}</ol></section>
    <section class='about-section'><div><p class='eyebrow'>03 / 研究与技术</p><h2>关注的问题</h2></div><div class='about-copy'><p>强化学习 · AI for Science · 科学机器学习 · 可复现研究</p><p>{site.about.stack.join(' · ')}</p></div></section>
  </main>
</PageLayout>

<style>
  .about-page { padding-top: 4.5rem; }
  .about-heading { max-width: 49rem; padding-bottom: 4rem; border-bottom: 1px solid var(--rule); }
  .about-heading h1 { margin: .75rem 0 1.25rem; font: 500 clamp(3rem,7vw,5.8rem)/.98 Georgia,serif; letter-spacing: -.065em; }
  .about-heading h1 em { color: hsl(var(--primary)); font-style: normal; }
  .about-heading>p:last-child,.about-copy p { color: hsl(var(--muted-foreground)); line-height: 1.85; }
  .about-section { display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; padding: 3.5rem 0; border-bottom: 1px solid var(--rule); }
  .about-section h2 { margin: .6rem 0 0; font-size: 1.35rem; font-weight: 500; }
  .about-copy p { margin: 0 0 1rem; }
  .principles-list { margin: 0; padding: 0; list-style: none; }
  .principles-list li { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; padding: .9rem 0; border-top: 1px solid var(--rule); }
  .principles-list li:first-child { border-top: 0; padding-top: 0; }
  .principles-list span { color: hsl(var(--primary)); font: .7rem ui-monospace,monospace; }
  .principles-list p { margin: 0; line-height: 1.65; }
  @media(max-width:700px){.about-page{padding-top:3rem}.about-section{grid-template-columns:1fr;gap:1.5rem;padding:2.75rem 0}}
</style>
