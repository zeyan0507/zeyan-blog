---
import type { GetStaticPaths,Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'
import { getUniqueTags } from 'astro-pure/server'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostList from '@/components/blog/PostList.astro'
export const prerender=true
export const getStaticPaths:GetStaticPaths=async({paginate})=>{const posts=(await getCollection('blog',({data})=>!data.draft&&data.language.toLowerCase().startsWith('zh'))).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());return getUniqueTags(posts).flatMap(tag=>paginate(posts.filter(post=>post.data.tags.includes(tag)),{pageSize:8,params:{tag}}))}
interface Props{page:Page<CollectionEntry<'blog'>>}
const {page}=Astro.props
const {tag}=Astro.params
const meta={title:`标签：${tag}`,description:`浏览标签为 ${tag} 的中文笔记。`,language:'zh-CN'}
---
<PageLayout {meta}><main class='page-column page'><a class='back' href='/zh/tags'>← 全部标签</a><header><p class='eyebrow'>笔记 / 标签</p><h1>#{tag}</h1></header><PostList posts={page.data}/><div class='pagination'>{page.url.prev&&<a href={page.url.prev}>← 较新</a>}{page.url.next&&<a href={page.url.next}>较旧 →</a>}</div></main></PageLayout>
<style>.page{padding-top:3rem}.back{color:hsl(var(--muted-foreground));font-size:.8rem}.page header{margin:3rem 0 2rem}.page h1{margin:.7rem 0 0;font:500 clamp(2.5rem,6vw,4.5rem)/1 Georgia,serif;letter-spacing:-.05em}.pagination{display:flex;justify-content:space-between;margin-top:1.5rem}</style>
