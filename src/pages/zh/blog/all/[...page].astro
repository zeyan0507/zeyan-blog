---
import type { GetStaticPaths,Page } from 'astro'
import { getCollection,type CollectionEntry } from 'astro:content'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostList from '@/components/blog/PostList.astro'
import CategoryNav from '@/components/blog/CategoryNav.astro'
export const getStaticPaths=(async({paginate})=>{const posts=(await getCollection('blog',({data})=>!data.draft&&data.language.toLowerCase().startsWith('zh'))).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf());return paginate(posts,{pageSize:8})}) satisfies GetStaticPaths
interface Props{page:Page<CollectionEntry<'blog'>>}
const {page}=Astro.props
const meta={title:'全部文章',description:'这本笔记中的所有中文研究、技术与学习记录。',language:'zh-CN'}
---
<PageLayout {meta}><main class='page-column all-page'><header><p class='eyebrow'>笔记 / 全部文章</p><h1>全部</h1><p>{meta.description}</p></header><CategoryNav active='all'/><PostList posts={page.data}/>{page.lastPage>1&&<nav class='pagination'>{page.url.prev?<a href={page.url.prev}>← 较新</a>:<span/>}<span>{page.currentPage} / {page.lastPage}</span>{page.url.next?<a href={page.url.next}>较旧 →</a>:<span/>}</nav>}</main></PageLayout>
<style>.all-page{padding-top:4.5rem}.all-page header{max-width:44rem}.all-page h1{margin:.7rem 0 1rem;font:500 clamp(3rem,7vw,5.4rem)/1 Georgia,serif;letter-spacing:-.06em}.all-page header p:last-child{color:hsl(var(--muted-foreground));line-height:1.75}.pagination{display:flex;justify-content:space-between;margin-top:2rem}</style>
