---
import type { GetStaticPaths, Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection } from 'astro:content'

import PageLayout from '@/layouts/BaseLayout.astro'
import CategoryNav from '@/components/blog/CategoryNav.astro'
import PostList from '@/components/blog/PostList.astro'
import { site } from '@/site-config'

export const prerender = true
const labels: Record<string, [string, string]> = {
  research: ['研究', '正在探索的问题、实验与工作记录。'],
  technical: ['技术', '工具、系统、代码与实践笔记。'],
  'learning-notes': ['学习笔记', '通过写作把概念理解得更清楚。'],
  'daily-life': ['日常', '技术生活之外的记录。']
}
export const getStaticPaths: GetStaticPaths = async ({ paginate }) => {
  const posts = await getCollection(
    'blog',
    ({ data }) => !data.draft && data.language.toLowerCase().startsWith('zh')
  )
  return site.blogCategories
    .filter((x) => x.slug !== 'all' && x.slug !== 'paper-reading')
    .flatMap((category) =>
      paginate(
        posts
          .filter((post) => post.data.category === category.slug)
          .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()),
        { pageSize: 8, params: { category: category.slug }, props: { category } }
      )
    )
}
interface Props {
  page: Page<CollectionEntry<'blog'>>
  category: (typeof site.blogCategories)[number]
}
const { page, category } = Astro.props
const [title, description] = labels[category.slug] || [category.label, category.description]
const meta = { title, description, language: 'zh-CN' }
---

<PageLayout {meta}
  ><main class='page-column page'>
    <header>
      <p class='eyebrow'>笔记 / 分类</p><h1>{title}</h1><p>{description}</p>
    </header><CategoryNav active={category.slug} />{
      page.data.length ? <PostList posts={page.data} /> : <p class='empty'>该分类暂无中文笔记。</p>
    }<div class='pagination'>
      {page.url.prev && <a href={page.url.prev}>← 较新</a>}{
        page.url.next && <a href={page.url.next}>较旧 →</a>
      }
    </div>
  </main></PageLayout
>
<style>
  .page {
    padding-top: 4.5rem;
  }
  .page header {
    max-width: 44rem;
  }
  .page h1 {
    margin: 0.7rem 0 1rem;
    font:
      500 clamp(3rem, 7vw, 5.4rem)/1 Georgia,
      serif;
    letter-spacing: -0.06em;
  }
  .page header p:last-child,
  .empty {
    color: hsl(var(--muted-foreground));
    line-height: 1.75;
  }
  .pagination {
    display: flex;
    justify-content: space-between;
    margin-top: 1.5rem;
  }
</style>
