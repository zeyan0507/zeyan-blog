---
import { getCollection } from 'astro:content'
import PageLayout from '@/layouts/BaseLayout.astro'
import CollectionList from '@/components/collections/CollectionList.astro'
import PostList from '@/components/blog/PostList.astro'
const collections = await getCollection('collections')
const posts = (await getCollection('blog', ({data}) => !data.draft && data.language.toLowerCase().startsWith('zh'))).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf())
const meta = { title: '笔记', description: '学习笔记、论文阅读与实践记录。', language: 'zh-CN' }
---
<PageLayout {meta}><main class='page-column notes-page'><header class='notes-heading'><p class='eyebrow'>笔记 / 工作中的知识</p><h1>笔记</h1><p>{meta.description}</p></header><section><div class='section-heading'><div><p class='eyebrow'>01 / 长期主题</p><h2>专题集</h2></div><a href='/zh/collections'>打开索引 →</a></div><CollectionList {collections}/></section><section><div class='section-heading'><div><p class='eyebrow'>02 / 最新笔记</p><h2>近期写作</h2></div><a href='/zh/blog/all'>全部文章 →</a></div>{posts.length?<PostList {posts}/>:<p>中文笔记正在整理中。</p>}</section></main></PageLayout>
<style>.notes-page{padding-top:4.5rem}.notes-heading{max-width:44rem;padding-bottom:3rem;border-bottom:1px solid var(--rule)}.notes-heading h1{margin:.7rem 0 1rem;font:500 clamp(3rem,7vw,5.4rem)/1 Georgia,serif;letter-spacing:-.06em}.notes-heading p:last-child{color:hsl(var(--muted-foreground));line-height:1.8}.notes-page section{margin-top:4.5rem}.section-heading{display:flex;align-items:end;justify-content:space-between;gap:1rem;margin-bottom:1.5rem}.section-heading h2{margin:.55rem 0 0;font-size:1.35rem}.section-heading>a{color:hsl(var(--muted-foreground));font-size:.78rem}</style>
