---
import { getCollection } from 'astro:content'
import PageLayout from '@/layouts/BaseLayout.astro'
import HomePage from '@/components/home/HomePage.astro'

const posts = (await getCollection('blog', ({ data }) => !data.draft && data.language.toLowerCase().startsWith('zh'))).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)

const meta = { title: 'Zeyan 的中文笔记', description: '关于研究、工程与学习的中文记录。', language: 'zh-CN' }
const collections = await getCollection('collections')
---

<PageLayout {meta}>
  <HomePage language='zh-CN' {posts} {collections} />
</PageLayout>
