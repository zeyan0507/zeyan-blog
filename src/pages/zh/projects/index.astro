---
import PageLayout from '@/layouts/BaseLayout.astro'
import { site } from '@/site-config'
const meta = { title: '项目', description: '支持这本笔记的小型系统、实验和工具。', language: 'zh-CN' }
const statusMap: Record<string,string> = { 'In progress': '进行中', Exploring: '探索中', Prototype: '原型' }
const projectZh: Record<string, { name: string; description: string }> = {
  'Research Notebook': { name: '研究笔记系统', description: '一个将实验与阅读笔记整理成持久知识的小型发布系统。' },
  'Reproducible Lab Notes': { name: '可复现实验笔记', description: '让模型运行、基本假设与实验结果始终靠近的模板和脚本。' },
  'Reading Queue': { name: '论文阅读队列', description: '一套轻量工作流，用于安排论文优先级，同时保留未解问题的线索。' }
}
const relatedZh: Record<string,string> = {
  'astro-blog-setup': 'astro-blog-setup-zh',
  'research-notes': 'research-notes-zh',
  'from-dqn-to-ppo': 'from-dqn-to-ppo-zh'
}
---
<PageLayout {meta}><main class='page-column projects-page'><header class='projects-heading'><p class='eyebrow'>项目 / 工作台</p><h1>我正在<br /><em>构建的事物。</em></h1><p>{meta.description}</p></header><section class='project-list' aria-label='项目'>{site.projects.map((project,index)=>{const localized=projectZh[project.name];return <article class='project-row'><span class='project-index'>0{index+1}</span><div><div class='title-line'><h2>{localized?.name || project.name}</h2><span>{statusMap[project.status] || project.status}</span></div><p>{localized?.description || project.description}</p><div class='meta'>{project.stack} · {project.year}</div>{project.related.map((id)=><a class='related' href={`/zh/blog/${relatedZh[id] || id}`}>相关笔记 →</a>)}</div></article>})}</section><section class='projects-note'><p class='eyebrow'>关于未完成的工作</p><p>这里的大多数项目都刻意保持小而清晰。更重要的不是它们看起来多完美，而是是否让问题更容易提出、实验更容易重复、结果更容易检查。</p></section></main></PageLayout>
<style>
 .projects-page{padding-top:4.5rem}.projects-heading{max-width:47rem;padding-bottom:4rem;border-bottom:1px solid var(--rule)}.projects-heading h1{margin:.75rem 0 1.25rem;font:500 clamp(3rem,7vw,5.8rem)/.98 Georgia,serif;letter-spacing:-.065em}.projects-heading em{color:hsl(var(--primary));font-style:normal}.projects-heading>p:last-child,.project-row div>p,.projects-note p:last-child{color:hsl(var(--muted-foreground));line-height:1.8}.project-row{display:grid;grid-template-columns:2rem 1fr;gap:1.5rem;padding:1.65rem 0;border-bottom:1px solid var(--rule)}.project-index,.related{color:hsl(var(--primary));font-size:.75rem}.title-line{display:flex;gap:1rem;align-items:baseline}.title-line h2{margin:0;font-size:1.15rem}.title-line span,.meta{color:hsl(var(--muted-foreground));font:.68rem ui-monospace,monospace}.related{display:inline-block;margin-top:.8rem}.projects-note{display:grid;grid-template-columns:1fr 2fr;gap:4rem;margin-top:4rem;padding-top:1.2rem;border-top:1px solid var(--rule)}@media(max-width:700px){.projects-page{padding-top:3rem}.projects-note{grid-template-columns:1fr;gap:1.25rem}}
</style>
