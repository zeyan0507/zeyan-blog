---
import { getCollection } from 'astro:content'
import PageLayout from '@/layouts/BaseLayout.astro'
import PostList from '@/components/blog/PostList.astro'
const posts=(await getCollection('blog',({data})=>!data.draft&&data.language.toLowerCase().startsWith('zh')&&data.category==='research')).sort((a,b)=>b.data.publishDate.valueOf()-a.data.publishDate.valueOf())
const meta={title:'研究',description:'关注让学习系统更易于理解、复现，并应用于科学问题的方法。',language:'zh-CN'}
const interests=['强化学习','AI for Science','科学机器学习','可复现研究']
const topics=[['策略优化','理解使学习信号真正有用的假设。'],['科学反问题','让模型尊重问题结构，而不是将它隐藏。'],['研究工具','让从想法到证据的路径更易检查。']]
---
<PageLayout {meta}><main class='page-column research-page'><header class='heading'><p class='eyebrow'>研究 / 进行中的问题</p><h1>研究</h1><p>{meta.description}</p></header><section class='interests'><div><p class='eyebrow'>01 / 方向</p><h2>反复回到的问题</h2></div><ul>{interests.map(x=><li>{x}</li>)}</ul></section><section><div class='section-heading'><div><p class='eyebrow'>02 / 工作中的问题</p><h2>当前主题</h2></div></div><div class='topic-grid'>{topics.map(([title,description],index)=><article><span>0{index+1}</span><h3>{title}</h3><p>{description}</p></article>)}</div></section><section><div class='section-heading'><div><p class='eyebrow'>03 / 已发布笔记</p><h2>研究笔记</h2></div><a href='/zh/blog/research'>查看全部 →</a></div>{posts.length?<PostList {posts}/>:<p>更多中文研究笔记正在整理中。</p>}</section></main></PageLayout>
<style>.research-page{padding-top:4.5rem}.heading{max-width:46rem;padding-bottom:3rem;border-bottom:1px solid var(--rule)}.heading h1{margin:.7rem 0 1rem;font:500 clamp(3rem,7vw,5.4rem)/1 Georgia,serif;letter-spacing:-.06em}.heading p:last-child,.topic-grid p{color:hsl(var(--muted-foreground));line-height:1.8}.research-page section{margin-top:4.5rem}.interests{display:grid;grid-template-columns:1fr 2fr;gap:4rem}.interests ul{display:flex;flex-wrap:wrap;align-content:start;gap:.6rem 1.4rem;margin:0;padding:0;list-style:none}.interests li{padding-bottom:.35rem;border-bottom:1px solid var(--rule)}h2{margin:.55rem 0 0;font-size:1.35rem;font-weight:500}.section-heading{display:flex;align-items:end;justify-content:space-between;margin-bottom:1.7rem}.section-heading>a{color:hsl(var(--muted-foreground));font-size:.78rem}.topic-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:2rem}.topic-grid article{padding-top:.9rem;border-top:1px solid var(--rule)}.topic-grid span{color:hsl(var(--primary));font:.7rem ui-monospace,monospace}.topic-grid h3{margin:.6rem 0 .4rem}.topic-grid p{margin:0;font-size:.85rem}@media(max-width:700px){.research-page{padding-top:3rem}.interests,.topic-grid{grid-template-columns:1fr;gap:1.5rem}}</style>
