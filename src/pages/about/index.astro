---
import PageLayout from '@/layouts/BaseLayout.astro'
import { site } from '@/site-config'

const meta = {
  title: 'About',
  description: `About ${site.author}, the person behind ${site.title}.`
}
---

<PageLayout {meta}>
  <main class='page-column about-page'>
    <header class='about-heading'>
      <p class='eyebrow'>About / the notebook</p>
      <h1>Making room for<br /><em>careful work.</em></h1>
      <p>{site.about.intro}</p>
    </header>

    <div class='about-grid'>
      <section class='about-section' aria-labelledby='approach-title'>
        <div>
          <p class='eyebrow'>01 / Approach</p>
          <h2 id='approach-title'>How I use this site</h2>
        </div>
        <div class='about-copy'>
          <p>
            This is a public working notebook rather than a finished portfolio. I use it to turn
            questions into explanations, experiments into records, and useful implementation
            details into something I can find again.
          </p>
          <p>
            The writing moves between reinforcement learning, scientific machine learning,
            research tooling, and the quieter work of learning a difficult idea well.
          </p>
        </div>
      </section>

      <section class='about-section' aria-labelledby='principles-title'>
        <div>
          <p class='eyebrow'>02 / Principles</p>
          <h2 id='principles-title'>A few working rules</h2>
        </div>
        <ol class='principles-list'>
          {site.about.principles.map((principle, index) => (
            <li><span>0{index + 1}</span><p>{principle}</p></li>
          ))}
        </ol>
      </section>

      <section class='about-section' aria-labelledby='contact-title'>
        <div>
          <p class='eyebrow'>03 / Elsewhere</p>
          <h2 id='contact-title'>Continue the conversation</h2>
        </div>
        <div class='about-links'>
          {site.social.email && <a href={site.social.email}>Email <span>↗</span></a>}
          {site.social.github && <a href={site.social.github}>GitHub <span>↗</span></a>}
          {site.social.scholar && <a href={site.social.scholar}>Google Scholar <span>↗</span></a>}
          {site.about.cv && <a href={site.about.cv}>CV <span>↗</span></a>}
          {!Object.values(site.social).some(Boolean) && <p class='placeholder-copy'>Contact links will appear here when configured.</p>}
        </div>
      </section>
      <section class='about-section' aria-labelledby='background-title'>
        <div><p class='eyebrow'>04 / Background</p><h2 id='background-title'>Education & experience</h2></div>
        <div class='about-copy'>
          <h3>Education</h3>
          {site.about.education.length ? site.about.education.map((item) => <p><strong>{item.title}</strong><br />{item.period} · {item.detail}</p>) : <p>No education details published yet.</p>}
          <h3>Experience</h3>
          {site.about.experience.length ? site.about.experience.map((item) => <p><strong>{item.title}</strong><br />{item.period} · {item.detail}</p>) : <p>No experience details published yet.</p>}
        </div>
      </section>
      <section class='about-section' aria-labelledby='tools-title'>
        <div><p class='eyebrow'>05 / Tools & questions</p><h2 id='tools-title'>Research & technology</h2></div>
        <div class='about-copy'><p>{site.research.interests.join(' · ')}</p><p>{site.about.stack.join(' · ')}</p></div>
      </section>
    </div>
  </main>
</PageLayout>

<style>
  .about-page { padding-top: 4.5rem; }
  .about-heading { max-width: 49rem; padding-bottom: 4rem; border-bottom: 1px solid var(--rule); }
  .about-heading h1 { margin: 0.75rem 0 1.25rem; font: 500 clamp(3rem, 7vw, 5.8rem)/0.98 Georgia, 'Times New Roman', serif; letter-spacing: -0.065em; }
  .about-heading h1 em { color: hsl(var(--primary)); font-style: normal; }
  .about-heading > p:last-child { max-width: 40rem; margin: 0; color: hsl(var(--muted-foreground)); font-size: 1.05rem; line-height: 1.85; }
  .about-grid { display: grid; gap: 0; }
  .about-section { display: grid; grid-template-columns: 1fr 2fr; gap: 4rem; padding: 3.5rem 0; border-bottom: 1px solid var(--rule); }
  .about-section h2 { margin: 0.6rem 0 0; font-size: 1.35rem; font-weight: 500; }
  .about-copy { max-width: 42rem; }
  .about-copy p { margin: 0 0 1rem; color: hsl(var(--muted-foreground)); font-size: 0.98rem; line-height: 1.85; }
  .about-copy p:last-child { margin-bottom: 0; }
  .principles-list { display: grid; gap: 0; margin: 0; padding: 0; list-style: none; }
  .principles-list li { display: grid; grid-template-columns: 2rem 1fr; gap: 1rem; padding: 0.9rem 0; border-top: 1px solid var(--rule); }
  .principles-list li:first-child { padding-top: 0; border-top: 0; }
  .principles-list span { color: hsl(var(--primary)); font: 0.7rem ui-monospace, SFMono-Regular, Menlo, monospace; }
  .principles-list p { margin: 0; font-size: 0.98rem; line-height: 1.65; }
  .about-links { display: flex; flex-wrap: wrap; gap: 1rem 2rem; align-items: start; }
  .about-links a { padding-bottom: 0.25rem; border-bottom: 1px solid var(--rule); font-size: 0.92rem; }
  .about-links a:hover { border-color: hsl(var(--primary)); }
  .about-links span { color: hsl(var(--primary)); }
  .placeholder-copy { color: hsl(var(--muted-foreground)); font-size: 0.92rem; }
  .about-copy h3 { margin-bottom: 0.65rem; font-size: 1rem; font-weight: 500; }
  .about-copy h3:not(:first-child) { margin-top: 2rem; }
  @media (max-width: 700px) {
    .about-page { padding-top: 3rem; }
    .about-heading { padding-bottom: 3rem; }
    .about-section { grid-template-columns: 1fr; gap: 1.5rem; padding: 2.75rem 0; }
  }
</style>
