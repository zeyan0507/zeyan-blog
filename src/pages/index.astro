---
import { getCollection } from 'astro:content'
import PageLayout from '@/layouts/BaseLayout.astro'
import HomePage from '@/components/home/HomePage.astro'
import { site } from '@/site-config'

const posts = (await getCollection('blog', ({ data }) => !data.draft && !data.language.toLowerCase().startsWith('zh'))).sort(
  (a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf()
)
const collections = await getCollection('collections')
---

<PageLayout meta={{ title: site.title, description: site.description }}>
  <HomePage language='en-US' {posts} {collections} />
</PageLayout>
