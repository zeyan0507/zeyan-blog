---
import type { SiteMeta } from 'astro-pure/types'
import { ThemeProvider } from 'astro-pure/components/basic'
import BaseHead from '@/components/BaseHead.astro'
import Header from '@/components/navigation/Header.astro'
import Footer from '@/components/navigation/Footer.astro'
import SearchDialog from '@/components/search/SearchDialog.astro'
import '@/assets/styles/global.css'
import '@/assets/styles/app.css'
import { site } from '@/site-config'
import { getPageLanguageLinks } from '@/utils/languages'

interface Props { meta: SiteMeta; highlightColor?: string; languageLinks?: { href: string; label: string; lang: string }[] }
const { meta, highlightColor, languageLinks, ...props } = Astro.props
const { language = site.locale.lang, description = site.description } = meta
const resolvedLanguageLinks = languageLinks ?? getPageLanguageLinks(Astro.url.pathname, language)
---

<html lang={language}>
  <head><BaseHead {...meta} {description} /><ThemeProvider {...site.appearance} />
    {site.analytics.enabled && site.analytics.scriptSrc && <script is:inline defer src={site.analytics.scriptSrc} data-website-id={site.analytics.websiteId}></script>}
  </head>
  <body class='flex min-h-[100dvh] justify-center bg-background text-foreground' {...props}>
    <div class='site-shell flex min-h-[100dvh] w-full flex-col px-5 sm:px-8 lg:px-10'>
      <a class='skip-link' href='#main-content'>{language.startsWith('zh') ? '跳转到正文' : 'Skip to content'}</a>
      <Header language={language} languageLinks={resolvedLanguageLinks} />
      <div id='main-content' class='flex-1 min-w-0' tabindex='-1'><slot /></div>
      <Footer language={language} />
    </div>
    {!Astro.url.pathname.endsWith('/search') && <SearchDialog {language} />}
    <style define:vars={{ highlightColor }}>
      :global(.highlight) { color: var(--highlightColor, hsl(var(--primary))) !important; }
    </style>
  </body>
</html>
