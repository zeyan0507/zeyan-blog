---
import { site } from '@/site-config'

interface Props { language?: string }
const { language } = Astro.props
const isChinese = language?.toLowerCase().startsWith('zh')
---

<footer class='mt-20 border-t border-[var(--rule)] py-6 text-xs text-muted-foreground sm:mt-28'>
  <div class='flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between'>
    <p>{isChinese ? '慢慢构建，认真发布。' : site.footer.note} <span class='mx-1'>·</span> © {new Date().getFullYear()} {isChinese ? site.authorZh : site.author}</p>
    <nav class='flex gap-4' aria-label={isChinese ? '页脚导航' : 'Footer navigation'}>
      {site.footer.links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  </div>
</footer>
